// Azure Batch test configuration for wf4 (VIEW workflow)
//
// Runs the tests/ test case on Azure Batch using the small test databases
// shipped in tests/ (~8MB). No staged reference data is required: every DB is
// declared as a `path` input by its module, so Nextflow uploads it to the
// az:// workDir and stages it into each task container automatically.
//
// Because of that, the view_test pool needs no start task, no NVMe refdata
// and no /mnt/nvme mount.
//
// Run with:
//   ./deploy/azure/run-wf4-test.sh
// which invokes:
//   nextflow run main.nf -profile azure_test,test ...
//
// The trailing `test` profile is required for two reasons:
//   1. it supplies the tests/ DB paths (see nextflow.config), and
//   2. workflows/view/main.nf only triggers GENOMAD_DOWNLOAD_DB when the
//      profile list literally contains the token 'test' — 'azure_test' does
//      not match, and the run would abort on a missing genomad_db.

workDir = 'az://workdata/work'

process {

    executor = 'azurebatch'
    // Fail loudly: a test run that silently skips processes proves nothing.
    errorStrategy = 'terminate'
    queue = 'view_test'

    // The test pool stages only the taxdump (see setup-wf4-test.sh.template),
    // which is consumed as a `val` input and so must be visible inside the
    // task container at its node-local path.
    containerOptions = "-v /mnt/nvme/refdata:/mnt/nvme/refdata:ro"

    // All processes constrained to L8as_v3 resources (8 vCPU, 64GB RAM)
    cpus   = 2
    memory = 8.GB
    time   = 1.h

    // NOTE: selectors here must use the ALIASED process names from
    // workflows/view/main.nf. Note also that an identical withName key
    // REPLACES the matching block in conf/azure.config rather than merging
    // with it, so any container set there must be restated here.

    withName: 'KRAKEN2_KRAKEN2|KRAKEN2_ABUNDANCE_ESTIMATE' {
        cpus     = 4
        memory   = 16.GB
        maxForks = 1
        time     = 2.h
    }

    withName: 'KAIJU_KAIJU' {
        cpus     = 4
        memory   = 16.GB
        maxForks = 1
        time     = 2.h
    }

    withName: 'MEGABLAST|MEGABLAST_ROUND2|MEGABLAST_TO_REF' {
        // Restated: see note above.
        container = "quay.io/biocontainers/blast:2.16.0--h66d330f_4"
        cpus     = 4
        memory   = 16.GB
        maxForks = 1
        time     = 2.h
    }

    withName: 'SPADES' {
        cpus     = 4
        memory   = 16.GB
        maxForks = 1
        time     = 4.h
    }

}

azure {

    storage {
        accountName = 'daffstandard'
    }

    batch {
        location          = 'australiaeast'
        accountName       = 'daffbatch'
        accountKey        = System.getenv('AZURE_BATCH_ACCESS_KEY')
        autoPoolMode      = false
        allowPoolCreation = false

        copyToolInstallMode     = 'task'
        deleteTasksOnCompletion = false
        deleteJobsOnCompletion  = false
    }
}
