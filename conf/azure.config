// Azure Batch configuration for wf4 (VIEW workflow)
//
// Load credentials before running:
//   export $(grep -v '^#' .env.azure | xargs)
//
// Required env vars:
//   AZURE_BATCH_ACCESS_KEY
//   AZURE_STORAGE_ACCOUNT_KEY

// Azure Blob work directory (standard storage, auto-cleaned after 14 days)
workDir = 'az://workdata/wf4'

process {

    // All processes run on Azure Batch to maximize single-node utilisation.
    // Reference data (~830GB) is staged once per node at startup via start task.
    // Pool autoscales 0->1 node; all tasks run on the same node.
    // taskSlotsPerNode=48 allows Nextflow to dispatch up to 48 concurrent tasks.

    executor = 'azurebatch'
    // 'terminate' so a failed process stops the run and is visible. Using
    // 'ignore' here reports success while silently dropping outputs.
    errorStrategy = 'terminate'
    queue = 'view'

    // Mount refdata directory (staged to NVMe by the pool start task).
    // Both blob containers are merged into /mnt/nvme/refdata/ — there is no
    // refdata-wf4 subdirectory.
    containerOptions = "-v /mnt/nvme/refdata:/mnt/nvme/refdata:ro"

    // NOTE: withName selectors below must use the ALIASED process names from
    // workflows/view/main.nf (the `include { X as Y }` names), not the module
    // process names. Nextflow matches the alias as a full-string regex; a
    // selector that matches nothing falls back to the conf/base.config labels
    // and its maxForks cap silently does not apply.

    // -----------------------------------------------------------------------
    // Heavy compute: BLAST
    // Needs core_nt (269GB, in /mnt/nvme/refdata)
    // -----------------------------------------------------------------------
    withName: 'MEGABLAST|MEGABLAST_ROUND2|MEGABLAST_TO_REF' {
        // container repeated from nextflow.config: an identical withName key
        // REPLACES the earlier block rather than merging with it, so omitting
        // it here leaves these processes with no image. Keep the two in sync.
        container = "quay.io/biocontainers/blast:2.16.0--h66d330f_4"
        cpus = 16
        memory = 64.GB
        maxForks = 2
        time = 4.h
    }

    // -----------------------------------------------------------------------
    // Heavy compute: Kraken2 (315GB DB, memory-mapped)
    // -----------------------------------------------------------------------
    withName: 'KRAKEN2_KRAKEN2|KRAKEN2_ABUNDANCE_ESTIMATE' {
        cpus = 8
        memory = 340.GB
        maxForks = 1
        time = 4.h
    }

    // -----------------------------------------------------------------------
    // Heavy compute: Kaiju (175GB DB)
    // -----------------------------------------------------------------------
    withName: 'KAIJU_KAIJU' {
        // Restated from nextflow.config: an identical withName key REPLACES
        // the earlier block rather than merging with it, so without this the
        // process would fall back to its module's unqualified image and be
        // rejected by Azure Batch.
        container = "quay.io/biocontainers/kaiju:1.10.0--h43eeafb_0"
        cpus = 8
        memory = 200.GB
        maxForks = 1
        time = 4.h
    }

    // -----------------------------------------------------------------------
    // Assembly: SPAdes (CPU and memory intensive)
    // -----------------------------------------------------------------------
    withName: 'SPADES' {
        cpus = 16
        memory = 64.GB
        maxForks = 2
        time = 8.h
    }

    // -----------------------------------------------------------------------
    // Protein domain search: HMMSCAN (Pfam-A.hmm 1.8GB)
    // -----------------------------------------------------------------------
    withName: 'HMMSCAN' {
        // See note above: identical withName key replaces, so the container
        // must be restated here.
        container = "quay.io/biocontainers/hmmer:3.4--hb6cb901_4"
        cpus = 8
        memory = 16.GB
        maxForks = 4
        time = 4.h
    }

    // -----------------------------------------------------------------------
    // Viral sequence classification: GeNomad
    // -----------------------------------------------------------------------
    withName: 'GENOMAD_ENDTOEND' {
        cpus = 8
        memory = 32.GB
        maxForks = 4
        time = 4.h
    }

    // -----------------------------------------------------------------------
    // Alignment: BWA
    // -----------------------------------------------------------------------
    withName: 'MAP_TO_CONTIGS|MAPPING_BACK_TO_REF|REALIGN' {
        cpus = 8
        memory = 16.GB
        maxForks = 4
        time = 2.h
    }

    // -----------------------------------------------------------------------
    // Lightweight processes: can run many in parallel
    // -----------------------------------------------------------------------
    withName: 'FASTP|FASTQC_RAW|FASTQC_TRIM|SEQTK_SEQ|EXTRACT_CONTIGS|SAMTOOLS_REF|SAMTOOLS_CONTIGS|SAMTOOLS_MPILEUP|TRIM_ENDS|MOSDEPTH_CONTIGS|MOSDEPTH_REF|PYFAIDX_REF|PYFAIDX_CONTIGS|BCFTOOLS|BEDTOOLS|CLUSTER|ORFIPY|RETRIEVE_VIRAL_READS_KRAKEN2|KRAKEN2_TO_KRONA|KRONA_KTIMPORTTEXT|EXTRACT_REF_FASTA|EXTRACT_BLAST_HITS|EXTRACT_RAW_VIRAL_BLAST_HITS|EXTRACT_FINAL_VIRAL_BLAST_HITS|FASTA2TABLE_CONTIGS|FASTA2TABLE_REF|CONTIG_COVSTATS|REF_COVSTATS|SUMMARISE_READ_CLASSIFICATION|SUMMARISE_RESULTS|HTML_REPORT|QC_REPORT|IDENTIFY_ERRORS' {
        cpus = 2
        memory = 8.GB
        maxForks = 16
        time = 1.h
    }

}

azure {

    storage {
        accountName = 'daffstandard'
        // Key is read automatically from: AZURE_STORAGE_ACCOUNT_KEY
    }

    batch {
        location          = 'australiaeast'
        accountName       = 'daffbatch'
        accountKey        = System.getenv('AZURE_BATCH_ACCESS_KEY')
        autoPoolMode      = false
        allowPoolCreation = false

        copyToolInstallMode     = 'task'
        deleteTasksOnCompletion = false
        deleteJobsOnCompletion  = false
    }
}
