// Local smoke test: docker executor, the tiny Wsmv test DB instead of
// core_nt, CPUs scaled down. Proves the workflow wiring before any Azure
// spend.

docker.enabled = true

params {
    queries = "${projectDir}/queries.fasta"
    // Mounted at a path outside the project tree (below), not its real
    // location under projectDir: bind-mounting it under the same parent
    // as workDir, alongside Nextflow's own work-dir bind mount, makes
    // blastn fail every time with "Database memory map file error" (seen
    // while building this test). The two mounts don't overlap, so this
    // looks like a docker/runc mount-propagation bug rather than anything
    // about the DB or the query; it doesn't apply to the Azure run, where
    // workDir is blob storage and the DB mount is the unrelated NVMe path.
    blastn_db = '/mnt/smoke-test-db/Wsmv.fa'
    outdir = 'results/smoke-test'
}

process {
    // blastn_db is a val (string), not a path, so Nextflow won't stage it.
    containerOptions = "-v ${projectDir}/../blast_test_db:/mnt/smoke-test-db:ro"

    withName: 'NODE_UP' {
        container = "quay.io/biocontainers/blast:2.16.0--h66d330f_4"
        cpus = 1
        memory = 1.GB
    }
    withName: 'BLAST_BATCH' {
        container = "quay.io/biocontainers/blast:2.16.0--h66d330f_4"
        cpus = 2
        memory = 2.GB
    }
    withName: 'BLAST_SINGLE' {
        container = "quay.io/biocontainers/blast:2.16.0--h66d330f_4"
        cpus = 1
        memory = 1.GB
        // Cap concurrency at 3 to match the slot packing Azure applies
        // for real (see blast-perf.config), for a representative test.
        maxForks = 3
    }
}

report {
    enabled = true
    file = "${params.outdir}/report.html"
}

trace {
    enabled = true
    file = "${params.outdir}/trace.txt"
    fields = 'task_id,name,tag,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,rchar'
}
