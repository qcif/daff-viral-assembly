// Azure config for the batch-vs-per-query MEGABLAST performance test.
// Reuses the azure{} block, executor, queue and containerOptions from
// conf/azure.config, then overrides only what this test needs.

includeConfig '../../conf/azure.config'

workDir = 'az://workdata/blast-perf'

params {
    queries = "${projectDir}/queries.fasta"
    blastn_db = '/mnt/nvme/refdata/core_nt/core_nt'
    outdir = 'results'
}

process {
    withName: 'NODE_UP' {
        // Container restated: an identical withName key across config files
        // replaces rather than merges, dropping the container set in
        // conf/azure.config (see azure-batch-handover.md).
        container = "quay.io/biocontainers/blast:2.16.0--h66d330f_4"
        cpus = 1
        memory = 2.GB
        time = 30.m
        maxForks = 1
    }
    withName: 'BLAST_BATCH' {
        // Container restated: an identical withName key across config files
        // replaces rather than merges, dropping the container set in
        // conf/azure.config (see azure-batch-handover.md).
        container = "quay.io/biocontainers/blast:2.16.0--h66d330f_4"
        cpus = 48
        memory = 300.GB
        time = 4.h
        maxForks = 1
    }
    withName: 'BLAST_SINGLE' {
        container = "quay.io/biocontainers/blast:2.16.0--h66d330f_4"
        cpus = 16
        memory = 100.GB
        time = 4.h
    }
    withName: 'BLAST_PASS_.*' {
        // Container restated: an identical withName key across config files
        // replaces rather than merges, dropping the container set in
        // conf/azure.config (see azure-batch-handover.md).
        container = "quay.io/biocontainers/blast:2.16.0--h66d330f_4"
        // Fixed at 48 for every pass, cold and warm: only the -num_threads
        // flag passed into blastn varies (see cores.nf), so every pass
        // gets the same Batch slot/scheduling treatment.
        cpus = 48
        memory = 300.GB
        time = 1.h
        maxForks = 1
    }
    withName: 'SCALE_BATCH' {
        // Container restated (see notes above).
        container = "quay.io/biocontainers/blast:2.16.0--h66d330f_4"
        cpus = 48
        memory = 300.GB
        time = 6.h
        maxForks = 1
    }
    withName: 'SCALE_SPLIT_CHUNK' {
        // Container restated (see notes above).
        container = "quay.io/biocontainers/blast:2.16.0--h66d330f_4"
        cpus = 16
        memory = 100.GB
        time = 6.h
        maxForks = 3
    }
}

report {
    enabled = true
    file = "${params.outdir}/report.html"
}

trace {
    enabled = true
    file = "${params.outdir}/trace.txt"
    fields = 'task_id,name,tag,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,rchar'
}
