#!/usr/bin/env bash

# Enable verbose logging for debugging (all commands echo to stderr)
set -x

# Exit on error
set -euo pipefail

# -----------------------------------------------------------------------------
# CONFIGURATION
# -----------------------------------------------------------------------------

NVME_MNT="/mnt/nvme"
# Both containers download into /mnt/nvme/refdata/:
#   refdata     → /mnt/nvme/refdata/  (core_nt, taxdump)
#   refdata-wf4 → /mnt/nvme/refdata/  (kraken2, kaiju, pfam, etc.)
REFDATA_DIR="$NVME_MNT"

# Anonymous blob access enabled for both containers
# refdata: shared with taxodactyl (core_nt, taxdump)
REFDATA_BLOB_URL="https://daffstandard.blob.core.windows.net/refdata-wf2/"

# refdata-wf4: wf4-specific reference databases (kraken2, kaiju, pfam, etc.)
# Downloading into /mnt/nvme/refdata so everything is under one directory
REFDATA_WF4_BLOB_URL="https://daffstandard.blob.core.windows.net/refdata-wf4"

# Batch task working directories. Every task stages a full copy of its inputs
# here, which overflowed the VM's temp disk on large runs. Batch does not allow
# the node root to be relocated, so the workitems dir is bind-mounted from the
# NVMe instead (transparent to the Batch agent and to task containers).
BATCH_ROOT_DIR="${AZ_BATCH_NODE_ROOT_DIR:-/mnt/batch/tasks}"
BATCH_WORKITEMS_DIR="$BATCH_ROOT_DIR/workitems"
NVME_WORKITEMS_DIR="$NVME_MNT/batch-workitems"

# Docker images and container writable layers default to /var/lib/docker on the
# small OS disk; move them to the NVMe too.
DOCKER_DAEMON_JSON="/etc/docker/daemon.json"
DOCKER_OLD_ROOT="/var/lib/docker"
NVME_DOCKER_ROOT="$NVME_MNT/docker"

# -----------------------------------------------------------------------------
# FUNCTIONS
# -----------------------------------------------------------------------------

detect_nvme_device() {
    echo "=== Detecting NVMe device ===" >&2
    echo "Available block devices:" >&2
    lsblk >&2 || true
    echo "NVMe devices:" >&2
    ls -la /dev/nvme* >&2 || true

    local dev
    dev=$(lsblk -ndo NAME,TYPE | awk '$2=="disk" {print $1}' | grep nvme | head -n 1)

    if [[ -z "$dev" ]]; then
        echo "ERROR: No NVMe disk detected via lsblk. Trying direct detection..." >&2
        if [[ -b /dev/nvme0n1 ]]; then
            dev="nvme0n1"
        else
            echo "ERROR: No NVMe disk detected." >&2
            exit 1
        fi
    fi

    echo "Selected NVMe device: /dev/$dev" >&2
    echo "/dev/$dev"
}

mount_nvme() {
    local dev="$1"
    echo "=== Mounting NVMe device $dev ===" >&2

    mkdir -p "$NVME_MNT"

    if ! blkid "$dev" >/dev/null 2>&1; then
        echo "Formatting NVMe device $dev..." >&2
        mkfs.ext4 -F "$dev"
    else
        echo "NVMe device $dev already formatted" >&2
        blkid "$dev" >&2 || true
    fi

    if ! mount | grep -q "$NVME_MNT"; then
        echo "Mounting NVMe filesystem to $NVME_MNT..." >&2
        mount "$dev" "$NVME_MNT"
        echo "Mount successful" >&2
    else
        echo "NVMe already mounted at $NVME_MNT" >&2
    fi

    echo "Current mounts:" >&2
    mount | grep nvme >&2 || true
    df -h "$NVME_MNT" >&2 || true
}

relocate_batch_workitems() {
    echo "=== Relocating Batch task dirs to NVMe ===" >&2
    echo "Batch workitems dir: $BATCH_WORKITEMS_DIR" >&2

    if mountpoint -q "$BATCH_WORKITEMS_DIR"; then
        echo "$BATCH_WORKITEMS_DIR is already a mount point — skipping." >&2
        df -h "$BATCH_WORKITEMS_DIR" >&2 || true
        return
    fi

    mkdir -p "$BATCH_WORKITEMS_DIR" "$NVME_WORKITEMS_DIR"

    # Preserve anything the agent has already created (normally empty on a
    # fresh node, as the start task runs before any job task)
    if [[ -n "$(ls -A "$BATCH_WORKITEMS_DIR")" ]]; then
        echo "Copying existing workitems contents to NVMe..." >&2
        cp -a "$BATCH_WORKITEMS_DIR/." "$NVME_WORKITEMS_DIR/"
    fi

    # Match ownership/permissions of the original dir so the agent and task
    # users can still write to it
    chown --reference="$BATCH_WORKITEMS_DIR" "$NVME_WORKITEMS_DIR"
    chmod --reference="$BATCH_WORKITEMS_DIR" "$NVME_WORKITEMS_DIR"

    mount --bind "$NVME_WORKITEMS_DIR" "$BATCH_WORKITEMS_DIR"
    echo "Bind-mounted $NVME_WORKITEMS_DIR -> $BATCH_WORKITEMS_DIR" >&2
    df -h "$BATCH_WORKITEMS_DIR" >&2 || true
}

relocate_docker_root() {
    echo "=== Relocating Docker data-root to NVMe ===" >&2

    # Always stop/start docker, even when already configured: after a reboot
    # docker can start before the NVMe is mounted and would write its data
    # under the bare /mnt/nvme mount point on the OS disk.
    systemctl stop docker.socket docker || true

    mkdir -p "$NVME_DOCKER_ROOT"

    # Carry over images already pulled (e.g. the pool's prefetched images) on
    # first relocation only
    if [[ -d "$DOCKER_OLD_ROOT" && -z "$(ls -A "$NVME_DOCKER_ROOT")" ]]; then
        echo "Copying $DOCKER_OLD_ROOT to $NVME_DOCKER_ROOT..." >&2
        cp -a "$DOCKER_OLD_ROOT/." "$NVME_DOCKER_ROOT/"
    fi

    # Merge data-root into any existing daemon.json rather than overwriting
    # settings the Batch image may rely on
    mkdir -p "$(dirname "$DOCKER_DAEMON_JSON")"
    python3 - "$DOCKER_DAEMON_JSON" "$NVME_DOCKER_ROOT" <<'EOF'
import json
import os
import sys

path, data_root = sys.argv[1], sys.argv[2]
config = {}
if os.path.exists(path) and os.path.getsize(path) > 0:
    with open(path) as f:
        config = json.load(f)
config["data-root"] = data_root
with open(path, "w") as f:
    json.dump(config, f, indent=2)
EOF
    echo "Docker daemon config:" >&2
    cat "$DOCKER_DAEMON_JSON" >&2

    systemctl start docker
    echo "Docker root dir: $(docker info --format '{{.DockerRootDir}}')" >&2

    if [[ "$(docker info --format '{{.DockerRootDir}}')" != "$NVME_DOCKER_ROOT" ]]; then
        echo "ERROR: Docker is not using $NVME_DOCKER_ROOT" >&2
        return 1
    fi

    # Reclaim the OS disk space now that everything lives on the NVMe
    if [[ -d "$DOCKER_OLD_ROOT" ]]; then
        rm -rf "${DOCKER_OLD_ROOT:?}"/*
    fi
}

install_azcopy() {
    echo "=== Installing azcopy ===" >&2

    if command -v azcopy >/dev/null 2>&1; then
        echo "azcopy already installed" >&2
        azcopy --version >&2 || true
        return
    fi

    echo "Downloading azcopy from Microsoft..." >&2
    wget -q -O azcopy.tar.gz https://aka.ms/downloadazcopy-v10-linux

    echo "Extracting azcopy..." >&2
    tar -xf azcopy.tar.gz --strip-components=1

    echo "Installing azcopy to /usr/local/bin..." >&2
    mv azcopy /usr/local/bin/
    chmod +x /usr/local/bin/azcopy

    echo "Cleaning up..." >&2
    rm -f azcopy.tar.gz

    echo "azcopy installed successfully" >&2
    azcopy --version >&2 || true
}

stage_refdata() {
    echo "=== Staging shared reference data (refdata) ===" >&2
    date >&2

    # Shared with taxodactyl: core_nt, taxdump
    if [[ -d "$REFDATA_DIR/refdata/core_nt" ]]; then
        echo "Shared refdata already staged at $REFDATA_DIR/refdata — skipping." >&2
        ls -lh "$REFDATA_DIR/refdata" >&2 || true
        return
    fi

    echo "Creating refdata directory: $REFDATA_DIR/refdata" >&2
    mkdir -p "$REFDATA_DIR/refdata"

    echo "Downloading shared refdata from: ${REFDATA_BLOB_URL}" >&2
    echo "Target: $REFDATA_DIR/refdata" >&2
    # The trailing `*` and the explicit `/refdata` destination are both load
    # bearing: copying the container root instead lands the contents in a
    # directory named after the container (/mnt/nvme/refdata-wf2), which is
    # outside the path the tasks bind-mount.
    azcopy copy \
        "${REFDATA_BLOB_URL}*" \
        "${REFDATA_DIR}/refdata" \
        --recursive \
        --check-md5 NoCheck \
        --cap-mbps 0

    echo "Shared refdata download completed" >&2
    du -sh "$REFDATA_DIR/refdata" >&2 || true
    date >&2
}

stage_refdata_wf4() {
    echo "=== Staging wf4-specific reference data (refdata-wf4) ===" >&2
    date >&2

    # Downloads into /mnt/nvme/refdata/ so everything lives under one root
    # wf4-specific: kraken2_db, kaiju_db, pfam, genomad_db, diamond, rvdb_taxonomy, rrna_ref
    if [[ -d "$REFDATA_DIR/refdata/kraken2_db" ]]; then
        echo "wf4 refdata already staged at $REFDATA_DIR/refdata — skipping." >&2
        ls -lh "$REFDATA_DIR/refdata" >&2 || true
        return
    fi

    echo "Downloading wf4 refdata from: ${REFDATA_WF4_BLOB_URL}" >&2
    echo "Target: $REFDATA_DIR/refdata" >&2
    azcopy copy \
        "${REFDATA_WF4_BLOB_URL}/*" \
        "${REFDATA_DIR}/refdata" \
        --recursive \
        --check-md5 NoCheck \
        --cap-mbps 0

    echo "wf4 refdata download completed" >&2
    du -sh "$REFDATA_DIR/refdata" >&2 || true
    date >&2
}

restore_genomad_symlinks() {
    echo "=== Restoring geNomad mini-DB symlinks ===" >&2

    # The geNomad DB ships genomad_mini_db_* as symlinks to their genomad_db_*
    # counterparts. Blob storage cannot represent symlinks, so they are excluded
    # from the upload and recreated here — following them at upload time would
    # roughly double the size of genomad_db for no benefit.
    #
    # Note: genomad_mini_db.dbtype and genomad_mini_db.index are NOT symlinks
    # upstream; they are real files and must be present in the container.
    local db_dir="$REFDATA_DIR/refdata/genomad_db"

    if [[ ! -d "$db_dir" ]]; then
        echo "ERROR: geNomad DB directory not found: $db_dir" >&2
        return 1
    fi

    # link name -> target (both relative to $db_dir)
    local links=(
        "genomad_mini_db:genomad_db"
        "genomad_mini_db_h:genomad_db_h"
        "genomad_mini_db_h.dbtype:genomad_db_h.dbtype"
        "genomad_mini_db_h.index:genomad_db_h.index"
        "genomad_mini_db.lookup:genomad_db.lookup"
        "genomad_mini_db_mapping:genomad_db_mapping"
        "genomad_mini_db.source:genomad_db.source"
        "genomad_mini_db_taxonomy:genomad_db_taxonomy"
    )

    local entry link target
    for entry in "${links[@]}"; do
        link="${entry%%:*}"
        target="${entry##*:}"

        if [[ ! -e "$db_dir/$target" ]]; then
            echo "ERROR: symlink target missing: $db_dir/$target" >&2
            return 1
        fi

        # -f replaces an existing link, -n avoids descending into one that
        # already points at a directory (makes re-runs idempotent)
        ln -sfn "$target" "$db_dir/$link"
    done

    echo "geNomad symlinks restored:" >&2
    ls -l "$db_dir"/genomad_mini_db* >&2 || true
}

# -----------------------------------------------------------------------------
# MAIN
# -----------------------------------------------------------------------------

echo "===== START TASK: Begin NVMe setup and refdata staging =====" >&2
echo "Date: $(date)" >&2
echo "User: $(whoami)" >&2
echo "Working directory: $(pwd)" >&2

echo "" >&2
echo "STEP 1: Detecting NVMe device" >&2
NVME_DEV=$(detect_nvme_device)
echo "✓ Detected NVMe device: $NVME_DEV" >&2

echo "" >&2
echo "STEP 2: Mounting NVMe device" >&2
if mount_nvme "$NVME_DEV"; then
    echo "✓ NVMe device mounted successfully" >&2
else
    echo "✗ Failed to mount NVMe device" >&2
    exit 1
fi

echo "" >&2
echo "STEP 3: Relocating Batch task dirs to NVMe" >&2
if relocate_batch_workitems; then
    echo "✓ Batch task dirs relocated" >&2
else
    echo "✗ Failed to relocate Batch task dirs" >&2
    exit 1
fi

echo "" >&2
echo "STEP 4: Relocating Docker data-root to NVMe" >&2
if relocate_docker_root; then
    echo "✓ Docker data-root relocated" >&2
else
    echo "✗ Failed to relocate Docker data-root" >&2
    exit 1
fi

echo "" >&2
echo "STEP 5: Installing azcopy" >&2
if install_azcopy; then
    echo "✓ azcopy installed successfully" >&2
else
    echo "✗ Failed to install azcopy" >&2
    exit 1
fi

echo "" >&2
echo "STEP 6: Staging shared reference data" >&2
if stage_refdata; then
    echo "✓ Shared reference data staging completed" >&2
else
    echo "✗ Failed to stage shared reference data" >&2
    exit 1
fi

echo "" >&2
echo "STEP 7: Staging wf4-specific reference data" >&2
if stage_refdata_wf4; then
    echo "✓ wf4 reference data staging completed" >&2
else
    echo "✗ Failed to stage wf4 reference data" >&2
    exit 1
fi

echo "" >&2
echo "STEP 8: Restoring geNomad mini-DB symlinks" >&2
if restore_genomad_symlinks; then
    echo "✓ geNomad symlinks restored" >&2
else
    echo "✗ Failed to restore geNomad symlinks" >&2
    exit 1
fi

echo "" >&2
echo "===== START TASK: Completed Successfully =====" >&2
exit 0
